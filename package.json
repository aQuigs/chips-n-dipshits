{
  "name": "chips-n-dipshits",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.ts",
    "prebuild": "if command -v sync-common > /dev/null; then sync-common; fi",
    "build": "tsc --noEmit -p . && tsc --noEmit -p src/client && tsc --noEmit -p src/gas && node scripts/build.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:e2e": "E2E=1 node --test tests/e2e.test.ts",
    "screenshots": "node scripts/screenshots.ts",
    "gallery": "node scripts/gallery.ts",
    "deploy": "npm run build && node scripts/deploy.ts"
  },
  "devDependencies": {
    "@google/clasp": "^3.4.1",
    "@types/google-apps-script": "^2.0.15",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2"
  }
}
